# Where leads land
DATABASE_URL=

# Meta pixel + Conversions API. The pixel id is public (it is in the page
# source); the access token is not.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# Optional: kick off the follow-up sequence
N8N_LEAD_WEBHOOK_URL=

# Practice details rendered on the page
NEXT_PUBLIC_PRACTICE_NAME="Bright Smile Dental"
NEXT_PUBLIC_PRACTICE_CITY="Charlotte"
NEXT_PUBLIC_PRACTICE_PHONE="+1 704 555 0142"

# Booking rules. The calendar is ours; there is no third-party embed.
PRACTICE_TIMEZONE=America/New_York
BOOKING_OPEN_HOUR=9
BOOKING_CLOSE_HOUR=17
BOOKING_LUNCH_HOUR=13
BOOKING_SLOT_MINUTES=60
BOOKING_MIN_NOTICE_HOURS=2
BOOKING_WINDOW_DAYS=30
